---
// Navigation follows the current page's series and language, never saved preference.
import { getAdjacentModules, getVariantUrl, type ModuleEntry } from '../utils/collection';
interface Props { entry: ModuleEntry; }
const { entry } = Astro.props;
const { prev, next } = await getAdjacentModules(entry.data.displayOrder, entry.data.book, entry.data.variant);
---

<nav class="prevnext" aria-label="上下章导航">
  {prev && (
    <a
      class="prev-card"
      href={getVariantUrl(prev)}
    >
      <span class="label">← 上一章 · {prev.data.module}</span>
      <span class="title">{prev.data.title}</span>
    </a>
  )}
  {!prev && <span class="prev-card placeholder" />}
  {next && (
    <a
      class="next-card"
      href={getVariantUrl(next)}
    >
      <span class="label">{next.data.module} · 下一章 →</span>
      <span class="title">{next.data.title}</span>
    </a>
  )}
  {!next && <span class="next-card placeholder" />}
</nav>



<style>
  .prevnext {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-6);
    margin: var(--space-24) 0 var(--space-12);
  }
  .prev-card, .next-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-6);
    background: var(--paper-raised);
    border: var(--border-w) solid var(--rule);
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: all var(--dur-base) var(--ease);
  }
  .prev-card:hover, .next-card:hover {
    border-color: var(--accent);
    box-shadow: var(--shadow-2);
    transform: translateY(-2px);
  }
  .prev-card:focus-visible, .next-card:focus-visible {
    outline: var(--outline-w) solid var(--accent);
    outline-offset: var(--outline-offset);
  }
  .next-card { text-align: right; }
  .placeholder { visibility: hidden; }
  .label {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--soft);
  }
  .title {
    color: var(--ink);
    font-weight: 500;
  }
</style>
