---
// Resolve historical links at build time; stale browser preferences cannot redirect TS readers.
import { getModuleBySlug, getVariantUrl } from '../utils/collection';
import { withBase } from '../utils/url';
interface Props { slug: string; label?: string; }
const { slug, label } = Astro.props;
const target = await getModuleBySlug(slug);
const inPython = /\/python\/?$/.test(Astro.url.pathname);
const historical = inPython && target?.data.book === 'internals' && target.data.counterpart
  ? await getModuleBySlug(target.data.counterpart) : undefined;
const href = historical ? getVariantUrl(historical) : target ? getVariantUrl(target) : withBase(`/modules/${slug}`);
---

<a href={href} class="module-link" data-target-slug={slug}>
  <slot>{label || slug}</slot>
</a>



<style>
  .module-link {
    color: var(--accent);
    font-weight: 500;
    text-decoration: underline;
    text-decoration-color: var(--accent-soft);
    text-underline-offset: var(--underline-offset);
    transition: text-decoration-color var(--dur-fast) var(--ease);
  }
  .module-link:hover {
    text-decoration-color: var(--accent);
  }
  .module-link:focus-visible {
    outline: var(--outline-w) solid var(--accent);
    outline-offset: var(--outline-offset);
    border-radius: var(--radius-sm);
  }
</style>
